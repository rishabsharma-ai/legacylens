# Copy to .env. Nothing here is secret except an LLM API key, if you add one.
SPANNER_EMULATOR_HOST=localhost:9010
SPANNER_PROJECT=legacylens-local
SPANNER_INSTANCE=legacylens
SPANNER_DATABASE=knowledge

# LLM (thread 4). Free key from https://aistudio.google.com, or use Ollama.
# LLM_MODEL=gemini/gemini-flash-latest
# GEMINI_API_KEY=
# LLM_MODEL=ollama_chat/qwen3:8b

# Optional cheaper model for easy, graph-only questions (see ADR-0009).
# LLM_MODEL_SMALL=gemini/gemini-flash-lite-latest
# LLM_MODEL=none turns the model off: answers show the evidence only.
